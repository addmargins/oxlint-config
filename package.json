{
  "name": "@addmargins/oxlint-config",
  "version": "0.1.0",
  "description": "Oxlint preset that keeps agent-written code reviewable.",
  "keywords": [
    "config",
    "javascript",
    "oxlint",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/addmargins/oxlint-config/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/addmargins/oxlint-config.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "dependencies": {
    "@nkzw/oxlint-config": "3.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "oxlint": "^1.94.0",
    "tsrs": "7.1.0-beta.tsrs2",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "oxlint": ">=1.94.0",
    "tsrs": ">=0.25.0-ts7.1.0-beta || ^7.1.0-beta.tsrs2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=24"
  }
}
